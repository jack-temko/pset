{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homework-guide.schema.json",
  "$comment": "Caps keep a walkthrough card-sized: 30 steps of 1000 chars, 6 hints, 10 equations, setup and answer 2000. reading is the model's statement of the problem it is about to solve, shown to the student ungated so a misread is caught before the walkthrough is trusted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reading", "setup", "hints", "steps", "equations", "answer"],
  "properties": {
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["given", "find"],
      "properties": {
        "given": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "find": { "type": "string", "minLength": 1, "maxLength": 500 },
        "figure": { "type": "string", "maxLength": 1000 }
      }
    },
    "setup": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "hints": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "steps": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "equations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "tex"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "tex": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "answer": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
