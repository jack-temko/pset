{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "equation.schema.json",
  "$comment": "Caps keep an envelope card-sized: 12 equations of 2000 chars, title 200, note 500. equations[] entries are bare TeX (rendered with KaTeX displayMode), so only emptiness is enforced, never content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "equations"],
  "properties": {
    "title": { "type": "string", "maxLength": 200 },
    "equations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "note": { "type": "string", "maxLength": 500 }
  }
}
