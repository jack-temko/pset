{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Starts a step inside a part. The renderer numbers steps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title"
  ],
  "properties": {
    "type": {
      "const": "step"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
