{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "One or two functions on one y-axis, with optional labeled points and vertical guides. A series is an expression in x over a domain, sampled by the server, or explicit points for tabular data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "x", "y", "series"],
  "properties": {
    "type": {
      "const": "plot"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "x": {
      "$ref": "#/$defs/axis"
    },
    "y": {
      "$ref": "#/$defs/axis"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "expr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "domain": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "maxItems": 500,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "oneOf": [
          {
            "required": ["expr", "domain"],
            "not": {
              "required": ["points"]
            }
          },
          {
            "required": ["points"],
            "not": {
              "anyOf": [
                {
                  "required": ["expr"]
                },
                {
                  "required": ["domain"]
                }
              ]
            }
          }
        ]
      }
    },
    "marks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x"],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}
