{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "The final result of a part, last in that part, labeled like the part. With no label it is the whole problem's.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "text"],
  "properties": {
    "type": {
      "const": "answer"
    },
    "label": {
      "type": "string",
      "maxLength": 40
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    }
  }
}
