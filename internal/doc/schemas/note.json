{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "An aside the reader can skip: small, muted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "text"],
  "properties": {
    "type": {
      "const": "note"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    }
  }
}
