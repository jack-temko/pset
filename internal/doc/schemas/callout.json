{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "A tinted box the reader shouldn't skip.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "tone",
    "text"
  ],
  "properties": {
    "type": {
      "const": "callout"
    },
    "tone": {
      "enum": [
        "insight",
        "caveat",
        "check"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    }
  }
}
