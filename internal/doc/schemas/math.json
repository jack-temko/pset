{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Display math: bare TeX, no delimiters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "tex"
  ],
  "properties": {
    "type": {
      "const": "math"
    },
    "tex": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
