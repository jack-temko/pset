{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "A guide's hint: first, exactly one. One or two sentences, no working.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "text"],
  "properties": {
    "type": {
      "const": "hint"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}
